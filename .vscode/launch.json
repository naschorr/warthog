{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ReplayDataGrabber - War Thunder - All Replays",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/replay_data_grabber/warthog_replay_data_grabber.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "python": "${workspaceFolder}/venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}"},
            "stopOnEntry": false,
            "redirectOutput": true,
            "args": [
                "--all"
            ]
        },
        {
            "name": "ReplayDataGrabber - War Thunder - New Replays",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/replay_data_grabber/warthog_replay_data_grabber.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "python": "${workspaceFolder}/venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}"},
            "stopOnEntry": false,
            "redirectOutput": true,
            "args": [
                "--new"
            ]
        },
        {
            "name": "VehicleDataGrabber",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/vehicle_data_grabber/warthog_vehicle_data_grabber.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "python": "${workspaceFolder}/venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}"},
            "stopOnEntry": false,
            "redirectOutput": true,
            "args": []
        },
        {
            "name": "Dev - ReplayDataGrabber - All Replays",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/replay_data_grabber/warthog_replay_data_grabber.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "python": "${workspaceFolder}/venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}"},
            "stopOnEntry": false,
            "redirectOutput": true,
            "args": [
                "--replay-dir-path", "${workspaceFolder}/data/replays",
                "--all"
            ]
        },
        {
            "name": "Dev - ReplayDataGrabber - New Replays",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/replay_data_grabber/warthog_replay_data_grabber.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "python": "${workspaceFolder}/venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}"},
            "stopOnEntry": false,
            "redirectOutput": true,
            "args": [
                "--replay-dir-path", "${workspaceFolder}/data/replays",
                "--new"
            ]
        },
        {
            "name": "Dev - ReplayDataGrabber - Single File",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/replay_data_grabber/warthog_replay_data_grabber.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "python": "${workspaceFolder}/venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}"},
            "stopOnEntry": false,
            "redirectOutput": true,
            "args": [
                "--file", "${input:replayFilePath}",
                "--output", "${input:outputDirPath}",
            ]
        },
        {
            "name": "Dev - ReplayDataCopier",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/replay_data_copier/warthog_replay_data_copier.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "python": "${workspaceFolder}/venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}"},
            "stopOnEntry": false,
            "redirectOutput": true,
            "args": [
                "--output-dir-path", "${workspaceFolder}/data/replays"
            ]
        },
        {
            "name": "Dev - BoosterBuddy",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/replay_data_explorer/warthog_booster_buddy.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "python": "${workspaceFolder}/venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}"},
            "stopOnEntry": false,
            "redirectOutput": true,
            "args": [
                "--config-path", "${workspaceFolder}/src/config.dev.json",
                "--type", "${input:boosterType}",
                "--audience", "${input:boosterAudience}",
                "--amount-percent", "${input:boosterAmountPercent}",
                "--duration-matches", "${input:boosterDurationMatches}"
            ]
        }
    ],
    "inputs": [
        {
            "id": "replayFilePath",
            "type": "promptString",
            "description": "Path to the .wrpl replay file"
        },
        {
            "id": "outputDirPath",
            "type": "promptString",
            "description": "Path to the output directory",
            "default": "${workspaceFolder}/data/replays"
        },
        {
            "id": "boosterType",
            "type": "pickString",
            "description": "Booster type",
            "options": [
                "research",
                "silver_lions"
            ],
            "default": "research"
        },
        {
            "id": "boosterAudience",
            "type": "pickString",
            "description": "Booster audience",
            "options": [
                "self",
                "public"
            ],
            "default": "self"
        },
        {
            "id": "boosterAmountPercent",
            "type": "promptString",
            "description": "Booster percentage (ex: `15`, `75`, `300`)",
            "default": "150"
        },
        {
            "id": "boosterDurationMatches",
            "type": "promptString",
            "description": "Duration in matches",
            "default": "1"
        }
    ]
}